# Environment Configuration
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=sqlite:///./data/db/trading_bot.db

# Gemini Sandbox API
GEMINI_API_KEY=your-gemini-sandbox-api-key
GEMINI_API_SECRET=your-gemini-sandbox-api-secret
GEMINI_BASE_URL=https://api.sandbox.gemini.com
GEMINI_WS_URL=wss://api.sandbox.gemini.com/v1/marketdata
GEMINI_SANDBOX=true

# Trading Configuration
MAX_POSITIONS=5
MAX_ORDER_SIZE=1000
COOLDOWN_SECONDS=60
DEFAULT_STOP_LOSS_PCT=0.02
DEFAULT_TAKE_PROFIT_PCT=0.04